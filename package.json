{
  "name": "pi-checklist",
  "version": "0.4.0",
  "private": true,
  "description": "Session-scoped checklist extension for Pi",
  "keywords": [
    "pi-package"
  ],
  "license": "MIT",
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "pnpm build && node --test tests/*.test.mjs",
    "clean": "rm -rf dist",
    "prepare": "lefthook install",
    "format:check": "oxfmt --check src",
    "lint": "oxlint --config .oxlintrc.json src",
    "verify": "pnpm format:check && pnpm lint && pnpm test"
  },
  "dependencies": {
    "@earendil-works/pi-tui": "^1.0.4",
    "typebox": "^1.3.36"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@earendil-works/pi-coding-agent": "*",
    "@oxlint/plugins": "1.87.0",
    "lefthook": "2.2.2",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "typescript": "^5.6.3"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "engines": {
    "node": ">=20"
  },
  "pi": {
    "extensions": [
      "./dist/index.js"
    ]
  },
  "packageManager": "pnpm@10.10.0"
}
